GRT001 error mocks/c_corpus/terragrunt.hcl:10:15 mocks/c_corpus
# mocks/c_validate_only/terragrunt.hcl line 9: "  core_name = " is 14 bytes.
GRT001 error mocks/c_validate_only/terragrunt.hcl:9:15 mocks/c_validate_only
