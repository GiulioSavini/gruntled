# top-level help lists report
exec gruntled-exit 0 help
stderr '^  report  '

# report help: exit 0, flags and exit codes
exec gruntled-exit 0 report -h
stderr '^usage: gruntled report '
stderr '--format text\|json\|sarif'
stderr '--blast'
stderr 'in Broken with --blast'
stderr 'over the 64 MiB cap or unavailable'
stderr '^  0  '
stderr '^  1  '
stderr '^  2  usage error'
stderr '^  3  no daemon'
! stdout .

# unknown flag: exit 2 with usage
exec gruntled-exit 2 report --bogus
stderr 'flag provided but not defined'
stderr '^usage: gruntled report '
! stdout .

# invalid format: exit 2 with usage
exec gruntled-exit 2 report --format xml
stderr 'invalid --format "xml"'
stderr '^usage: gruntled report '
! stdout .

# more than one path: exit 2
exec gruntled-exit 2 report a b
stderr 'more than one path given'
stderr '^usage: gruntled report '
! stdout .

# --blast with sarif: exit 2 with usage
exec gruntled-exit 2 report --blast --format sarif
stderr 'invalid --format "sarif" with --blast \(want text or json\)'
stderr '^usage: gruntled report '
! stdout .

# --depth belongs to blast --base: exit 2 with or without --blast
exec gruntled-exit 2 report --blast --depth 2
stderr '^gruntled: --depth is not supported by report; use gruntled blast --base <dir> --depth N$'
stderr '^usage: gruntled report '
! stdout .
exec gruntled-exit 2 report --depth 2
stderr '^gruntled: --depth is not supported by report; use gruntled blast --base <dir> --depth N$'
stderr '^usage: gruntled report '
! stdout .

# --blast with no daemon: exit 3
env XDG_RUNTIME_DIR=$WORK/rt
mkdir $WORK/rt
exec gruntled-exit 3 report --blast repo
stderr 'no watch daemon is running for '
! stdout .
! exists $WORK/rt/gruntled

-- repo/vpc/terragrunt.hcl --
-- repo/vpc/main.tf --
output "vpc_id" { value = "x" }
