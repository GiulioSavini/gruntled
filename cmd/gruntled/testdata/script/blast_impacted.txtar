# blast with a baseline: removing output "id" and adding variable "name" in
# modules/vpc breaks live/app (GRT001 on dependency.db.outputs.id) and puts
# the other direct consumers of modules/vpc at risk.
exec gruntled-exit 1 blast --base base cur
stdout '^baseline: base$'
stdout '^Broken \(1\):$'
stdout '^  live/app$'
stdout '^    live/app/terragrunt.hcl:7:\d+: GRT004 dependency "db" output "id" was removed from module "modules/vpc" \(target unit "live/db"\)'
! stdout GRT001
stdout '^Impacted \(2\):$'
stdout '^  live/cache \(module modules/vpc: \+variable name, -output id\)$'
stdout '^  live/db \(module modules/vpc: \+variable name, -output id\)$'
# Broken and Impacted are disjoint: live/app is listed once, under Broken
stdout -count=1 '^  live/app'
! stdout '^  live/app \(module'
# consumers of other modules and consumers of consumers are not Impacted
! stdout 'live/other'
! stdout 'live/edge'
# the GRT100 present in both trees is not new
! stdout 'GRT100'
! stdout 'live/bad'
! stderr .

# json: sorted, disjoint, with a summary
exec gruntled-exit 1 blast --base base --format json cur
stdout '"baseline": true'
! stdout '"note"'
stdout '"code": "GRT004"'
! stdout '"code": "GRT001"'
stdout '"broken": \[\n\s+\{\n\s+"unit": "live/app"'
stdout '"impacted": \[\n\s+\{\n\s+"unit": "live/cache",\n\s+"module": "modules/vpc"[\s\S]*"unit": "live/db"'
! stdout '"impacted": \[[\s\S]*"unit": "live/app"'
stdout '"added_variables": \[\n\s+"name"\n\s+\]'
stdout '"removed_outputs": \[\n\s+"id"\n\s+\]'
stdout '"summary": \{\n\s+"broken": 1,\n\s+"impacted": 2\n\s+\}'
! stderr .

# comment-only edit and reordering of the module: names unchanged, nothing
# Impacted
exec gruntled-exit 0 blast --base base comment
stdout '^Broken \(0\):$'
stdout '^Impacted \(0\):$'
! stderr .

# a new module and a deleted module are not diffed: nothing Impacted
exec gruntled-exit 0 blast --base base newmod
stdout '^Broken \(0\):$'
stdout '^Impacted \(0\):$'
! stderr .
-- base/live/app/terragrunt.hcl --
terraform {
  source = "../../modules/vpc"
}
dependency "db" {
  config_path = "../db"
}
inputs = { db_id = dependency.db.outputs.id }
-- base/live/bad/main.tf --
output "o" { value = "x" }
-- base/live/bad/terragrunt.hcl --
