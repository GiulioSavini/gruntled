# no arguments: top-level usage, exit 2
exec gruntled-exit 2
stderr 'usage: gruntled <command>'
! stdout .

# top-level help: exit 0, lists both commands
exec gruntled-exit 0 -h
stdout 'usage: gruntled <command>'
stdout '^  check   '
stdout '^  graph   print the repository graph as JSON \(--json\)$'
stdout '^  blast   '
stdout '^  rebase  '
stdout '"gruntled rebase -h"'
stdout '^  --version   print the version and commit, then exit$'
! stderr .
exec gruntled-exit 0 --help
stdout 'usage: gruntled <command>'
! stderr .
exec gruntled-exit 0 help
stdout 'usage: gruntled <command>'
! stderr .

# check help: exit 0 with the exit-code table
exec gruntled-exit 0 check -h
stdout '^usage: gruntled check \[--format text\|json\|sarif\] \[path\]$'
stdout '3  analysis could not run'
! stderr .

# graph help: exit 0 with the exit-code table
exec gruntled-exit 0 graph -h
stdout '^usage: gruntled graph --json \[path\]$'
stdout '^  0  graph printed, even with unknown units$'
stdout '^  2  usage error'
stdout '^  3  analysis could not run'
! stdout '^  1  '
! stderr .

# blast help: exit 0 with the exit-code table
exec gruntled-exit 0 blast -h
stdout '^usage: gruntled blast \[--base dir\] \[--format text\|json\] \[--depth N\] \[path\]$'
stdout '^  0  comparison completed'
stdout '^  1  comparison completed, at least one error diagnostic in Broken$'
stdout '^  2  usage error'
stdout '^  3  comparison could not run'
! stderr .

# unknown command: exit 2
exec gruntled-exit 2 frobnicate
stderr 'unknown command "frobnicate"'
stderr 'usage: gruntled <command>'
! stdout .
