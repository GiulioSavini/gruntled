# no arguments: top-level usage, exit 2
exec gruntled-exit 2
stderr 'usage: gruntled <command>'
! stdout .

# top-level help: exit 0, lists both commands
exec gruntled-exit 0 -h
stderr 'usage: gruntled <command>'
stderr '^  check   '
stderr '^  graph   print the repository graph as JSON \(--json\)$'
stderr '^  blast   '
stderr '^  --version   print the version and commit, then exit$'
exec gruntled-exit 0 --help
exec gruntled-exit 0 help

# check help: exit 0 with the exit-code table
exec gruntled-exit 0 check -h
stderr '^usage: gruntled check \[--format text\|json\|sarif\] \[path\]$'
stderr '3  analysis could not run'
! stdout .

# graph help: exit 0 with the exit-code table
exec gruntled-exit 0 graph -h
stderr '^usage: gruntled graph --json \[path\]$'
stderr '^  0  graph printed, even with unknown units$'
stderr '^  2  usage error'
stderr '^  3  analysis could not run'
! stderr '^  1  '
! stdout .

# blast help: exit 0 with the exit-code table
exec gruntled-exit 0 blast -h
stderr '^usage: gruntled blast \[--base dir\] \[--format text\|json\] \[path\]$'
stderr '^  0  comparison completed'
stderr '^  1  comparison completed, at least one error diagnostic in Broken$'
stderr '^  2  usage error'
stderr '^  3  comparison could not run'
! stdout .

# unknown command: exit 2
exec gruntled-exit 2 frobnicate
stderr 'unknown command "frobnicate"'
stderr 'usage: gruntled <command>'
! stdout .
