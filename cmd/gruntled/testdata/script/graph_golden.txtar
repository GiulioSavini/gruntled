# Graph golden: the full INT-01 document for a fixture with a block edge
# (skip_outputs = true), a dependencies paths edge, an unresolved dependency
# (non-literal config_path), a module-unknown unit (remote source), a
# config-unknown unit (syntax error), an unknown module (missing local source)
# and a two-unit cycle. graph runs no analyzers: exit 0, silent stderr.
exec gruntled-exit 0 graph --json .
cmp stdout want.json
! stderr .

-- vpc/terragrunt.hcl --
terraform {
  source = "../modules/net"
}
-- modules/net/main.tf --
output "vpc_id" { value = "x" }
-- app/terragrunt.hcl --
dependency "vpc" {
  config_path  = "../vpc"
  skip_outputs = true
}
dependency "dyn" {
  config_path = local.dyn
}
dependencies {
  paths = ["../dns"]
}
inputs = { id = dependency.vpc.outputs.vpc_id }
-- app/main.tf --
variable "id" {}
-- dns/terragrunt.hcl --
terraform {
  source = "git::https://example.com/dns.git"
}
-- db/terragrunt.hcl --
terraform {
  source = "../modules/missing"
}
-- broken/terragrunt.hcl --
dependency "vpc" {
  config_path = "../vpc"
-- ring/a/terragrunt.hcl --
dependency "b" {
  config_path = "../b"
}
-- ring/a/main.tf --
# no outputs
-- ring/b/terragrunt.hcl --
dependency "a" {
  config_path = "../a"
}
-- ring/b/main.tf --
# no outputs
-- want.json --
{
