# JSON golden: same fixture as text_golden, --format json. No stderr summary.
exec gruntled-exit 1 check . --format json
cmp stdout want.json
! stderr .

-- vpc/terragrunt.hcl --
-- vpc/main.tf --
output "vpc_id" { value = "x" }
-- app/terragrunt.hcl --
dependency "vpc" {
  config_path = "../vpc"
}
inputs = { id = dependency.vpc.outputs.vpc_idd }
-- app/main.tf --
variable "id" {}
-- dns/terragrunt.hcl --
terraform {
  source = "git::https://example.com/x.git"
}
-- root.hcl --
dependency "vpc" {
  config_path = "${get_terragrunt_dir()}/../vpc"
}
inputs = { net = dependency.vpc.outputs.subnet_id }
-- web/terragrunt.hcl --
include "root" {
  path = find_in_parent_folders("root.hcl")
}
-- web/main.tf --
variable "net" {}
-- api/terragrunt.hcl --
include "root" {
  path = find_in_parent_folders("root.hcl")
}
-- api/main.tf --
variable "net" {}
-- want.json --
