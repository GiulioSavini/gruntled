# top-level help lists watch
exec gruntled-exit 0 help
stdout '^  watch   '
! stderr .

# watch help: exit 0, flags and exit codes, no daemon started
exec gruntled-exit 0 watch -h
stdout '^usage: gruntled watch '
stdout '--poll '
stdout '--poll-interval '
stdout '--debounce '
stdout '--status-file '
stdout '--print-status-path'
stdout '^  0  '
stdout '^  2  usage error'
stdout '^  3  '
! stderr .

# unknown flag: exit 2 with usage
exec gruntled-exit 2 watch --bogus
stderr 'flag provided but not defined'
stderr '^usage: gruntled watch '
! stdout .

# more than one path: exit 2
exec gruntled-exit 2 watch a b
stderr 'more than one path given'
stderr '^usage: gruntled watch '
! stdout .
