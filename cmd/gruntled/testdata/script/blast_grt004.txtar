# GRT004 end to end (MORE-03): a dependency output that the baseline's module
# declared, that the current module no longer declares, and that the current
# tree still reads, is reported as GRT004 at each reading site instead of
# GRT001. Every failed precondition keeps v0.3 behaviour (GRT001 or silence).
#
# live/app (module modules/app) has dependency "db" -> live/db (module
# modules/vpc). Its inputs lines read "  a = dependency.db.outputs.<Y>":
# "  a = " is 6 bytes, so the reference starts at byte column 7.

# case 1: removed, two sites. base declares id, cur drops it, live/app reads it
# on lines 8 and 9 (column 7) -> one GRT004 per site, no GRT001, exit 1.
exec gruntled-exit 1 blast --base base1 cur1
stdout '^Broken \(1\):$'
stdout '^  live/app$'
stdout -count=2 'GRT004'
stdout '^    live/app/terragrunt.hcl:8:7: GRT004 dependency "db" output "id" was removed from module "modules/vpc" \(target unit "live/db"\)$'
stdout '^    live/app/terragrunt.hcl:9:7: GRT004 dependency "db" output "id" was removed from module "modules/vpc" \(target unit "live/db"\)$'
! stdout GRT001
stdout '^  live/db \(module modules/vpc: -output id\)$'
! stdout '^/'
! stdout '[A-Za-z]:\\'
! stderr .

# case 10: the same comparison as JSON: two GRT004 findings, schema version 1,
# no GRT001.
exec gruntled-exit 1 blast --base base1 --format json cur1
stdout '"version": 1'
stdout -count=2 '"code": "GRT004"'
! stdout GRT001
! stderr .

# case 11: case 1 reversed (the output is added back): nothing is Broken.
exec gruntled-exit 0 blast --base cur1 base1
stdout '^Broken \(0\):$'
! stdout 'GRT00'
! stderr .

# case 2: removed but unreferenced. cur drops "name", which nobody reads ->
# no finding, exit 0; the module's consumer live/db is Impacted, and so is
# live/app, which depends on live/db.
exec gruntled-exit 0 blast --base base2 cur2
stdout '^Broken \(0\):$'
stdout '^Impacted \(2\):$'
stdout -count=1 '^  live/app'
stdout '^  live/db \(module modules/vpc: -output name\)$'
! stdout 'GRT00'
! stderr .

# case 3: the reference is added in the same change (baseHadRef fails): base
# live/app reads nothing, cur reads id and the module drops it -> GRT001.
exec gruntled-exit 1 blast --base base3 cur3
stdout '^    live/app/terragrunt.hcl:8:7: GRT001 dependency "db" output "id" is not declared by module "modules/vpc" \(target unit "live/db"\)$'
! stdout GRT004
! stderr .

# case 4: re-pointed to another module (sameModule fails): base db -> live/db
# (modules/vpc declares id), cur db -> live/other (modules/other never had id)
# -> GRT001.
exec gruntled-exit 1 blast --base base4 cur4
stdout '^    live/app/terragrunt.hcl:8:7: GRT001 dependency "db" output "id" is not declared by module "modules/other" \(target unit "live/other"\)$'
! stdout GRT004
! stderr .

# case 5a: module unknown in the baseline (syntax error mid-edit) -> GRT001 in
# cur, no GRT004; the base GRT100 is not new.
exec gruntled-exit 1 blast --base base5a cur5a
stdout '^    live/app/terragrunt.hcl:8:7: GRT001 dependency "db" output "id" is not declared'
! stdout GRT004
! stdout GRT100
! stderr .

# case 5b: module unknown in cur -> the reference site is silent (no GRT001, no
# GRT004); the new GRT100 is what is Broken.
exec gruntled-exit 1 blast --base base5b cur5b
stdout 'GRT100'
! stdout GRT001
! stdout GRT004
! stdout '^  live/app$'
! stderr .

# case 6: the output was never declared in the baseline (baseDeclared fails):
# the GRT001 exists in both trees, so it is not new -> exit 0, Broken (0).
exec gruntled-exit 0 blast --base base6 cur6
stdout '^Broken \(0\):$'
! stdout 'GRT00'
! stderr .

# case 7a: enabled = false in cur: Terragrunt does not read outputs, silent -> exit 0.
exec gruntled-exit 0 blast --base base7a cur7a
stdout '^Broken \(0\):$'
! stdout 'GRT00'
! stderr .

# case 7b: skip_outputs = true in cur: Terragrunt does not read outputs, silent -> exit 0.
exec gruntled-exit 0 blast --base base7b cur7b
stdout '^Broken \(0\):$'
! stdout 'GRT00'
! stderr .

# case 7c: enabled = local.on (not a literal) in cur: Terragrunt does not read outputs, silent -> exit 0.
exec gruntled-exit 0 blast --base base7c cur7c
stdout '^Broken \(0\):$'
! stdout 'GRT00'
! stderr .

# case 7d: skip_outputs = local.skip (not a literal) in cur: Terragrunt does not read outputs, silent -> exit 0.
exec gruntled-exit 0 blast --base base7d cur7d
stdout '^Broken \(0\):$'
! stdout 'GRT00'
! stderr .

# case 8a: mock_outputs covers id, merge with state, apply allowed: mocks never
# suppress, so GRT004 still fires, with GRT001's mock suffix.
exec gruntled-exit 1 blast --base base8a cur8a
stdout '^    live/app/terragrunt.hcl:11:7: GRT004 dependency "db" output "id" was removed from module "modules/vpc" \(target unit "live/db"\); mock_outputs supplies it, so apply would silently use the mock value$'
! stdout GRT001
! stderr .

# case 8b: the mock does not apply at apply (apply not allowed) -> GRT004
# without the suffix.
exec gruntled-exit 1 blast --base base8b cur8b
stdout '^    live/app/terragrunt.hcl:11:7: GRT004 dependency "db" output "id" was removed from module "modules/vpc" \(target unit "live/db"\)$'
! stdout 'mock_outputs supplies'
! stdout GRT001
! stderr .

# case 9: the output moved to another .tf file of the module and gained
# deprecated: same names -> nothing Broken, nothing Impacted.
exec gruntled-exit 0 blast --base base9 cur9
stdout '^Broken \(0\):$'
stdout '^Impacted \(0\):$'
! stderr .
-- base1/live/app/terragrunt.hcl --
terraform {
  source = "../../modules/app"
}
dependency "db" {
  config_path = "../db"
}
inputs = {
  a = dependency.db.outputs.id
  b = dependency.db.outputs.id
}
-- base1/live/db/terragrunt.hcl --
terraform {
  source = "../../modules/vpc"
}
-- base1/modules/app/main.tf --
variable "a" {}
variable "b" {}
-- base1/modules/vpc/main.tf --
output "id" { value = "x" }
output "name" { value = "x" }
