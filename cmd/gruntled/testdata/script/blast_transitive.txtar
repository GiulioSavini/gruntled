}
dependency "c" {
  config_path = "../c"
}
-- base4/live/c/terragrunt.hcl --
terraform {
  source = "../../modules/app"
}
dependency "b" {
  config_path = "../b"
}
dependency "self" {
  config_path = "../c"
}
-- base4/modules/app/main.tf --
variable "v" {
  default = ""
}
-- base4/modules/m/main.tf --
output "id" { value = "x" }
output "gone" { value = "y" }
-- base5/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base5/live/b/terragrunt.hcl --
