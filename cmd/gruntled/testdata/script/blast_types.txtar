  type = object({ a = string, b = optional(number, 1) })
}
-- cur10/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur10/modules/m/main.tf --
# reformatted
variable "x" {
  type = object({
    # b first now
    b = optional(number, 2)
    a = string // still a string
  })
}
