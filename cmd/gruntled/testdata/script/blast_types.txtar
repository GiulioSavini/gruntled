  other = 1
}
-- base14/modules/m/main.tf --
variable "other" {}
-- cur14/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
inputs = {
  other = 1
}
-- cur14/modules/m/main.tf --
