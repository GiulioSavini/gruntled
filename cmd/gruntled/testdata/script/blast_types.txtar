  default = "a"
}
-- cur2/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur2/modules/m/main.tf --
variable "x" {}
-- base3/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base3/modules/m/main.tf --
variable "x" {
