  config_path = "../a"
}
-- base17/modules/m/main.tf --
variable "x" {
  type = string
}
-- cur17/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur17/live/b/terragrunt.hcl --
dependency "a" {
  config_path = "../a"
}
-- cur17/modules/m/main.tf --
variable "x" {
  type = number
}
