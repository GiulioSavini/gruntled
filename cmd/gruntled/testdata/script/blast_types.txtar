}
-- base5/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base5/modules/m/main.tf --
variable "x" {}
-- cur5/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur5/modules/m/main.tf --
variable "x" {
  type = string
}
-- base6/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base6/modules/m/main.tf --
output "o" {
  value = 1
  type  = string
}
-- cur6/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur6/modules/m/main.tf --
output "o" {
  value = 1
  type  = number
}
-- base7/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base7/modules/m/main.tf --
output "o" {
  value = 1
}
-- cur7/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur7/modules/m/main.tf --
output "o" {
  value = 1
  type  = number
}
-- base8/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base8/modules/m/main.tf --
output "o" {
  value = 1
}
-- cur8/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur8/modules/m/main.tf --
