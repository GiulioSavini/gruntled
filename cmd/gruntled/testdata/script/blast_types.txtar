variable "need" {
  type = string
}
-- base15/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base15/modules/m/main.tf --
variable "x" {
  type = string
}
output "o" {
  value = 1
}
-- cur15/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- cur15/modules/m/main.tf --
variable "x" {
  type        = string
  description = "d"
  nullable    = false
  ephemeral   = true
  const       = true
  deprecated  = "use y"
  validation {
    condition     = length(var.x) > 0
    error_message = "empty"
  }
}
output "o" {
  value      = 1
  ephemeral  = false
  deprecated = "no"
}
-- base17/live/a/terragrunt.hcl --
terraform {
  source = "../../modules/m"
}
-- base17/live/b/terragrunt.hcl --
